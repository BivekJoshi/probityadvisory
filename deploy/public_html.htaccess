# Apache config for the static site in public_html.
# Copied to dist/.htaccess by the deploy workflow — do not edit on the server,
# it is overwritten on every deploy.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Let AutoSSL validate over plain HTTP. cPanel exempts .well-known globally
  # today, but renewal runs unattended every ~90 days and a redirect here
  # fails it silently, expiring the certificate. Cheap insurance.
  RewriteRule ^\.well-known/ - [L]

  # Force HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Force the bare domain — pick one canonical host so SEO is not split.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # One address per page. /index.html and /about.html are the files behind / and
  # /about, never URLs of their own. THE_REQUEST is the line the browser sent,
  # so the internal rewrites below cannot trigger these.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # ... and no trailing slash, except on real directories.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Every route has its own HTML file, written by the build (plugins/staticPages.ts)
  # with that page's title, description and canonical URL: /about is about.html,
  # /team/deepak-pandey is team/deepak-pandey.html. React Router takes over in the browser.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !^/404$
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ /$1.html [L]
</IfModule>

# Anything else is a real 404 (not the old SPA fallback's 200), so search engines
# drop dead links. 404.html is the app shell, which renders the not-found page.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Files copied from public/ (team photos, favicon) keep their names across
  # deploys, so they get a short cache. Hashed build output under assets/ is
  # cached forever by its own .htaccess, written by the deploy workflow.
  <FilesMatch "\.(svg|png|jpg|jpeg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # HTML must revalidate or a deploy is invisible until the cache expires.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>
